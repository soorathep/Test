# =====================================================================
# skh_lab.mplstyle
# Teal-Amber Lab Palette v1.0 - publication profile
#
# Usage:
#   import matplotlib.pyplot as plt
#   plt.style.use("skh_lab.mplstyle")
# or, with the helper module:
#   import skh_palette as skh; skh.use()
#
# Note: hex colours are written without the leading '#' because '#'
# starts a comment in matplotlib style files.
# =====================================================================

# --- Colour cycle -----------------------------------------------------
# Fixed categorical order: teal, amber, rust, skyblue, sage, plum,
# graphite, sand. Semantics: teal = control/baseline/reference,
# amber = the effect of interest.
axes.prop_cycle: cycler('color', ['0F6E6B', 'E29A2D', 'BE654C', '5A91BE', '83A462', '995A90', '333F4A', 'DFC98F'])

# --- Canvas -----------------------------------------------------------
figure.facecolor:     white
figure.edgecolor:     white
axes.facecolor:       white
savefig.facecolor:    white
savefig.edgecolor:    white
savefig.transparent:  False

# --- Typography -------------------------------------------------------
font.family:          sans-serif
# Inter carries no Thai glyphs and matplotlib does not fall through this list per
# glyph, so Thai text needs skh.use(thai=True), which sets IBM Plex Sans Thai outright.
font.sans-serif:      Inter, Source Sans 3, Noto Sans Thai, IBM Plex Sans Thai, Sarabun, Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size:            9.0
axes.titlesize:       10.0
axes.labelsize:       9.0
xtick.labelsize:      8.0
ytick.labelsize:      8.0
legend.fontsize:      8.0
figure.titlesize:     11.0

text.color:           1C242B
axes.labelcolor:      1C242B
xtick.labelcolor:     1C242B
ytick.labelcolor:     1C242B
axes.titlecolor:      1C242B

# --- Axes: graphite, never pure black ---------------------------------
axes.edgecolor:       333F4A
axes.linewidth:       0.9
axes.spines.top:      False
axes.spines.right:    False
axes.axisbelow:       True
axes.titlelocation:   left
axes.titlepad:        6.0
axes.labelpad:        4.0

xtick.color:          333F4A
ytick.color:          333F4A
xtick.direction:      out
ytick.direction:      out
xtick.major.width:    0.9
ytick.major.width:    0.9
xtick.minor.width:    0.6
ytick.minor.width:    0.6
xtick.major.size:     3.5
ytick.major.size:     3.5
xtick.minor.size:     2.0
ytick.minor.size:     2.0

# --- Grid: mist, subtle -----------------------------------------------
axes.grid:            True
axes.grid.axis:       both
grid.color:           B9C1C6
grid.linewidth:       0.6
grid.alpha:           0.7
grid.linestyle:       -

# --- Lines and markers: minimum sizes enforced by the palette rules ---
lines.linewidth:      1.6
lines.markersize:     4.5
lines.markeredgewidth: 0.0
lines.solid_capstyle: round
lines.antialiased:    True

errorbar.capsize:     2.5

# --- Patches and scatter ----------------------------------------------
patch.linewidth:      0.8
patch.edgecolor:      333F4A
patch.force_edgecolor: False
scatter.marker:       o
hatch.linewidth:      0.6

# --- Legend -----------------------------------------------------------
legend.frameon:       False
legend.handlelength:  1.8
legend.handletextpad: 0.6
legend.columnspacing: 1.4
legend.labelspacing:  0.35
legend.borderaxespad: 0.4

# --- Images and colour maps -------------------------------------------
# Default sequential map. Ordered or continuous data must use a ramp,
# never the categorical cycle.
image.cmap:           viridis
image.interpolation:  nearest
image.origin:         lower

# --- Figure geometry: single-column journal default -------------------
figure.figsize:       3.35, 2.6
figure.dpi:           150
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.04
figure.constrained_layout.w_pad: 0.04

# --- Export: vector by default, 600 dpi for raster --------------------
savefig.dpi:          600
savefig.format:       pdf
savefig.bbox:         tight
savefig.pad_inches:   0.02

# TrueType embedding keeps text editable in Illustrator and satisfies
# publisher font-embedding checks. Type 3 (the default) does not.
pdf.fonttype:         42
ps.fonttype:          42
pdf.compression:      6
svg.fonttype:         none
